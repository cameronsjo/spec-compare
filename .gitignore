# The site uses npm ci in CI — its lockfile must be tracked despite the global ignore above.
!site/package-lock.json

# Vendored Artificer text files are generated by scripts/revendor-artificer.sh
# from the pinned @cameronsjo/artificer package (pre{dev,build}). The lockfile is
# the single source of truth; these regenerate on install. gitignore has no brace
# expansion, so the three globs are listed separately. The binary assets/** (fonts,
# favicon, og-image) stay TRACKED — the script never touches them.
site/public/artificer/*.css
site/public/artificer/*.js
site/public/artificer/*.json

# review-loop state (local only)
.review-loop.local.md
