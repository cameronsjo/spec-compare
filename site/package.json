{
  "name": "spec-compare-visualizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive comparison of spec-driven-development tools and their workflows",
  "scripts": {
    "validate": "node scripts/validate-tools.mjs",
    "gen:tables": "node scripts/gen-doc-tables.mjs",
    "gen:check": "node scripts/gen-doc-tables.mjs --check",
    "dev": "vite",
    "build": "npm run validate && npm run gen:check && tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.2",
    "vitest": "^3.2.4"
  }
}
